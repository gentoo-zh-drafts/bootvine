[Unit]
Description=Live dependency tree of boot jobs
DefaultDependencies=no
IgnoreOnIsolate=yes
After=dracut-cmdline-ask.service breakpoint-pre-udev.service breakpoint-pre-basic.service
After=breakpoint-pre-mount.service breakpoint-pre-switch-root.service
Before=display-manager.service shutdown.target emergency.service rescue.service
Before=dracut-emergency.service
Conflicts=shutdown.target emergency.service rescue.service dracut-emergency.service

[Service]
Type=simple
ExecStartPre=/usr/bin/bootvine save-console-state
ExecStart=@/usr/bin/bootvine @bootvine
ExecStopPost=/usr/bin/bootvine restore-console-state --status-output unless-clean-exit
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty12
TTYReset=yes
TTYVTDisallocate=no

[Install]
WantedBy=sysinit.target
