[Unit]
Description=Live dependency tree of boot jobs
DefaultDependencies=no
IgnoreOnIsolate=yes
Before=display-manager.service shutdown.target emergency.service rescue.service
Conflicts=shutdown.target emergency.service rescue.service

[Service]
Type=simple
ExecStartPre=/usr/bin/bootvine save-console-state
ExecStart=@/usr/bin/bootvine @bootvine
ExecStopPost=/usr/bin/bootvine restore-console-state
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty12
TTYReset=yes
TTYVTDisallocate=no

[Install]
WantedBy=sysinit.target
